# LedgerForge application settings (env prefix LF_)
LF_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ledgerforge
LF_DEBUG=false
# Colon-separated directories scanned for drop-in plugins
LF_PLUGIN_PATH=
# Load the built-in example plugin (GST transformer + policy validator)
LF_EXAMPLE_PLUGINS=true
# Permit voucher dates beyond tomorrow
LF_ALLOW_FUTURE_DATES=false
