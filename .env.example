# LedgerForge application settings (env prefix LF_) — every setting and
# its default, one line each. Copy to .env (gitignored) and edit.
LF_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ledgerforge
LF_DEBUG=false
# Colon-separated directories scanned for drop-in plugins
LF_PLUGIN_PATH=
# Load the built-in example plugin (GST transformer + policy validator)
LF_EXAMPLE_PLUGINS=true
# Permit voucher dates beyond tomorrow
LF_ALLOW_FUTURE_DATES=false

# --- authentication ---------------------------------------------------------
# dev default: every caller is an anonymous admin (a loud warning is logged;
# never expose this to untrusted networks). Production: oidc.
LF_AUTH_MODE=disabled
# Production guard (v0.16): when true, the app refuses to boot unless
# LF_AUTH_MODE=oidc is fully configured below.
LF_REQUIRE_AUTH=false
LF_OIDC_ISSUER=
LF_OIDC_AUDIENCE=
# Optional — skip OIDC discovery when the IdP blocks it
LF_OIDC_JWKS_URI=
# Extra browser origins allowed cross-origin (the web container proxies
# /api same-origin, so this is rarely needed)
LF_CORS_ORIGINS=

# ─────────────────────────────────────────────────────────────────────────────
# docker-compose.prod.yml additionally reads these (docs/deployment.md); the
# compose file makes a missing required value a loud startup error.
# ─────────────────────────────────────────────────────────────────────────────

# --- database credentials (the compose stack) -------------------------------
LF_DB_USER=ledgerforge
LF_DB_PASSWORD=change-me-a-long-random-secret
LF_DB_NAME=ledgerforge

# --- web ----------------------------------------------------------------------
LF_WEB_PORT=8080

# --- backups (the db-backup sidecar) -------------------------------------------
LF_BACKUP_RETENTION_DAYS=14
LF_BACKUP_INTERVAL_SECONDS=86400
